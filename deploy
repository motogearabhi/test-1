name: AKS Application Deployment

on:
  workflow_dispatch:

permissions:
  contents: read
  id-token: write

jobs:

  dev-deploy:
    name: Deploy to Dev
    runs-on: ubuntu-latest
    environment: development

    steps:
      - name: Checkout Code
        uses: actions/checkout@v4

      - name: Azure Login
        uses: azure/login@v2
        with:
          client-id: ${{ secrets.AZURE_CLIENT_ID }}
          tenant-id: ${{ secrets.AZURE_TENANT_ID }}
          subscription-id: ${{ secrets.AZURE_SUBSCRIPTION_ID }}

      - name: Set AKS Context
        uses: azure/aks-set-context@v4
        with:
          resource-group: ${{ vars.AKS_RESOURCE_GROUP }}
          cluster-name: ${{ vars.AKS_CLUSTER_NAME }}

      - name: Create TLS Files
        shell: pwsh
        run: |
          @"
          ${{ secrets.TLS_CERT }}
          "@ | Out-File tls.crt

          @"
          ${{ secrets.TLS_KEY }}
          "@ | Out-File tls.key

      - name: Create TLS Secret
        run: |
          kubectl create secret tls ingress-cert \
            --cert=tls.crt \
            --key=tls.key \
            --dry-run=client -o yaml > ingress-secret.yaml

      - name: Apply TLS Secret
        run: |
          kubectl apply -f ingress-secret.yaml

      - name: Create ConfigMaps
        run: |
          kubectl apply -f manifests/configmap.yaml

      - name: Create Secrets
        run: |
          kubectl apply -f manifests/secrets.yaml

      - name: Deploy Application
        run: |
          kubectl apply -f manifests/deployment.yaml
          kubectl apply -f manifests/service.yaml
          kubectl apply -f manifests/ingress.yaml

  dev-diagnostics:
    name: Dev Diagnostics
    runs-on: ubuntu-latest
    needs: dev-deploy

    steps:
      - name: Check Pods
        run: kubectl get pods -A

      - name: Check Services
        run: kubectl get svc -A

      - name: Check Ingress
        run: kubectl get ingress -A

  uat-deploy:
    name: Deploy to UAT
    runs-on: ubuntu-latest
    needs: dev-deploy
    environment: uat

    steps:
      - uses: actions/checkout@v4

      - uses: azure/login@v2
        with:
          client-id: ${{ secrets.UAT_AZURE_CLIENT_ID }}
          tenant-id: ${{ secrets.UAT_AZURE_TENANT_ID }}
          subscription-id: ${{ secrets.UAT_AZURE_SUBSCRIPTION_ID }}

      - uses: azure/aks-set-context@v4
        with:
          resource-group: ${{ vars.UAT_AKS_RG }}
          cluster-name: ${{ vars.UAT_AKS_CLUSTER }}

      - name: Deploy to UAT
        run: |
          kubectl apply -f manifests/

  uat-diagnostics:
    name: UAT Diagnostics
    runs-on: ubuntu-latest
    needs: uat-deploy

    steps:
      - run: kubectl get pods -A

  prod-deploy:
    name: Deploy to Production
    runs-on: ubuntu-latest
    needs: uat-deploy
    environment: production

    steps:
      - uses: actions/checkout@v4

      - uses: azure/login@v2
        with:
          client-id: ${{ secrets.PROD_AZURE_CLIENT_ID }}
          tenant-id: ${{ secrets.PROD_AZURE_TENANT_ID }}
          subscription-id: ${{ secrets.PROD_AZURE_SUBSCRIPTION_ID }}

      - uses: azure/aks-set-context@v4
        with:
          resource-group: ${{ vars.PROD_AKS_RG }}
          cluster-name: ${{ vars.PROD_AKS_CLUSTER }}

      - name: Deploy to Production
        run: |
          kubectl apply -f manifests/

  prod-diagnostics:
    name: Production Diagnostics
    runs-on: ubuntu-latest
    needs: prod-deploy

    steps:
      - run: kubectl get pods -A
